import Mathlib.Analysis.SpecialFunctions.SmoothTransition
import Mathlib.Analysis.Calculus.IteratedDeriv.Lemmas
import Mathlib.Algebra.Polynomial.Eval.Degree

/-! # Polynomial jets and Gaussian bounds for the flat exponential glue -/

noncomputable section

open Finset Polynomial
open scoped ContDiff

namespace expNegInvGlue

/-- The exact polynomial generated by repeated differentiation. -/
def jetPolynomial (p : ℝ[X]) : ℕ → ℝ[X]
  | 0 => p
  | r + 1 => X ^ 2 * (jetPolynomial p r - (jetPolynomial p r).derivative)

theorem iteratedDeriv_polynomial_eval_inv_mul (p : ℝ[X]) (r : ℕ) :
    iteratedDeriv r (fun x : ℝ => p.eval x⁻¹ * expNegInvGlue x) =
      fun x => (jetPolynomial p r).eval x⁻¹ * expNegInvGlue x := by
  induction r with
  | zero => simp [jetPolynomial]
  | succ r ih =>
    rw [iteratedDeriv_succ, ih]
    funext x
    exact (hasDerivAt_polynomial_eval_inv_mul (jetPolynomial p r) x).deriv

theorem iteratedDeriv_scaled_polynomial (p : ℝ[X]) (c : ℝ) (r : ℕ) :
    iteratedDeriv r (fun x : ℝ => p.eval (x / c)⁻¹ * expNegInvGlue (x / c)) =
      fun x => c⁻¹ ^ r * ((jetPolynomial p r).eval (x / c)⁻¹ * expNegInvGlue (x / c)) := by
  have h := iteratedDeriv_comp_const_mul
    (contDiff_polynomial_eval_inv_mul (n := r) p) c⁻¹
  rw [iteratedDeriv_polynomial_eval_inv_mul] at h
  simpa only [div_eq_mul_inv, mul_comm] using h

theorem pow_mul_exp_neg_half_le (k : ℕ) {y : ℝ} (hy : 0 ≤ y) :
    y ^ k * Real.exp (-y / 2) ≤ (2 : ℝ) ^ k * (k.factorial : ℝ) := by
  have hf : 0 < (k.factorial : ℝ) := by exact_mod_cast Nat.factorial_pos k
  have hp : (y / 2) ^ k ≤ (k.factorial : ℝ) * Real.exp (y / 2) := by
    have h := Real.pow_div_factorial_le_exp (y / 2) (by positivity : 0 ≤ y / 2) k
    exact (div_le_iff₀ hf).mp h |>.trans_eq (mul_comm _ _)
  calc
    y ^ k * Real.exp (-y / 2) = (2 : ℝ) ^ k * ((y / 2) ^ k * Real.exp (-y / 2)) := by
      rw [div_pow]
      field_simp
    _ ≤ (2 : ℝ) ^ k * ((k.factorial : ℝ) * Real.exp (y / 2) * Real.exp (-y / 2)) := by
      gcongr
    _ = (2 : ℝ) ^ k * (k.factorial : ℝ) := by
      rw [mul_assoc (k.factorial : ℝ), ← Real.exp_add]
      rw [show y / 2 + -y / 2 = 0 by ring]
      simp

/-- A fixed polynomial can be absorbed into half of the exponential. -/
theorem polynomial_mul_exp_neg_half_bound (p : ℝ[X]) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ y : ℝ, 0 ≤ y → |p.eval y| * Real.exp (-y / 2) ≤ C := by
  let C : ℝ := ∑ k ∈ range (p.natDegree + 1), |p.coeff k| * ((2 : ℝ) ^ k * (k.factorial : ℝ))
  refine ⟨C, sum_nonneg (fun _ _ => by positivity), fun y hy => ?_⟩
  calc
    _ ≤ (∑ k ∈ range (p.natDegree + 1), |p.coeff k * y ^ k|) * Real.exp (-y / 2) := by
      rw [Polynomial.eval_eq_sum_range]
      exact mul_le_mul_of_nonneg_right (abs_sum_le_sum_abs _ _) (Real.exp_nonneg _)
    _ = ∑ k ∈ range (p.natDegree + 1), |p.coeff k| * (y ^ k * Real.exp (-y / 2)) := by
      rw [sum_mul]
      apply sum_congr rfl
      intro k _
      rw [abs_mul, abs_of_nonneg (pow_nonneg hy k)]
      ring
    _ ≤ C := sum_le_sum (fun k _ => mul_le_mul_of_nonneg_left
      (pow_mul_exp_neg_half_le k hy) (abs_nonneg _))

/-- The same constant works for all positive scales and all times below `T`. -/
theorem scaled_polynomial_uniform_bound (p : ℝ[X]) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ c T t : ℝ, 0 < c → 0 < T → t ≤ T →
      |p.eval (t / c)⁻¹ * expNegInvGlue (t / c)| ≤ C * Real.exp (-c / (2 * T)) := by
  obtain ⟨C, hC, hp⟩ := polynomial_mul_exp_neg_half_bound p
  refine ⟨C, hC, fun c T t hc hT ht => ?_⟩
  by_cases ht0 : 0 < t
  · have he : |p.eval (t / c)⁻¹ * expNegInvGlue (t / c)| =
        (|p.eval (c / t)| * Real.exp (-(c / t) / 2)) * Real.exp (-(c / t) / 2) := by
      rw [show expNegInvGlue (t / c) = Real.exp (-c / t) by
          simp only [expNegInvGlue, not_le.mpr (div_pos ht0 hc), if_false, inv_div, neg_div],
        abs_mul, abs_of_pos (Real.exp_pos _),
        inv_div, mul_assoc, ← Real.exp_add]
      congr 2
      ring
    rw [he]
    apply mul_le_mul (hp _ (by positivity)) ?_ (Real.exp_nonneg _) hC
    apply Real.exp_le_exp.mpr
    have hd := div_le_div_of_nonneg_left hc.le ht0 ht
    calc
      -(c / t) / 2 ≤ -(c / T) / 2 := by linarith
      _ = -c / (2 * T) := by ring
  · rw [expNegInvGlue.zero_of_nonpos
      (div_nonpos_of_nonpos_of_nonneg (le_of_not_gt ht0) hc.le), mul_zero, abs_zero]
    positivity

/-- Derivative order is fixed before choosing the Gaussian envelope. -/
theorem iteratedDeriv_scaled_uniform_bound (p : ℝ[X]) (r : ℕ) :
    ∃ C : ℝ, 0 ≤ C ∧ ∀ c T t : ℝ, 1 ≤ c → 0 < T → t ≤ T →
      ‖iteratedDeriv r (fun x : ℝ => p.eval (x / c)⁻¹ * expNegInvGlue (x / c)) t‖ ≤
        C * Real.exp (-c / (2 * T)) := by
  obtain ⟨C, hC, hp⟩ := scaled_polynomial_uniform_bound (jetPolynomial p r)
  refine ⟨C, hC, fun c T t hc hT ht => ?_⟩
  have hc0 : 0 < c := zero_lt_one.trans_le hc
  have hi : c⁻¹ ^ r ≤ 1 := pow_le_one₀ (inv_nonneg.mpr hc0.le) (inv_le_one_of_one_le₀ hc)
  rw [iteratedDeriv_scaled_polynomial, Real.norm_eq_abs, abs_mul,
    abs_of_nonneg (pow_nonneg (inv_nonneg.mpr hc0.le) r)]
  calc
    _ ≤ 1 * (C * Real.exp (-c / (2 * T))) :=
      mul_le_mul hi (hp c T t hc0 hT ht) (abs_nonneg _) zero_le_one
    _ = _ := one_mul _

end expNegInvGlue
