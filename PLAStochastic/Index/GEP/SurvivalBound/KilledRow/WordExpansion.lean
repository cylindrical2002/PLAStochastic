import PLAStochastic.Index.GEP.SurvivalBound.KilledRow.Defs

/-!
# WP4 `SurvivalBound`: word expansion of the complex killed row, and product laws

Source: `rawdisc-design.md` §0, §2 (词展开).

**Product-law tools** for `P = Measure.infinitePi Q` on `ℕ → ℝ` (all `Q i` probability measures)
and their `wordLaw` forms:

* coordinates in disjoint index sets are independent (`kill_indep_coords`, from
  `iIndepFun_infinitePi` and `indep_iSup_of_disjoint`); a function measurable w.r.t. the
  coordinates in `S` is independent of one measurable w.r.t. the coordinates in `T`
  (`kill_indepFun_of_disjoint`);
* reindexing: for injective `c`, the law of `g ↦ g ∘ c` under `wordLaw ν σ S` is
  `wordLaw ν σ (S.preimage c)` (`wordLaw_map_comp`);
* head/tail: the law of `(g 0, g ∘ succ)` is `ρ₀ ⊗ wordLaw ν σ S'` with `ρ₀ = σ` iff `0 ∈ S`
  and `i ∈ S' ↔ i + 1 ∈ S` (`wordLaw_map_head`, `integral_wordLaw_head`);
* disjoint blocks: the law of `(g ∘ c₁, g ∘ c₂)` is the product of the reindexed word laws, so
  `∫ F(g ∘ c₁) G(g ∘ c₂) = ∫ F · ∫ G` (`wordLaw_map_blocks`, `integral_mul_wordLaw_blocks`);
  for functions measurable w.r.t. disjoint coordinate sets (e.g. of `s.restrict g`, `t.restrict g`
  for disjoint finsets) `∫ F G = ∫ F · ∫ G` (`integral_mul_wordLaw_of_disjoint`,
  `integral_mul_wordLaw_finset`); finite marginals (`integral_wordLaw_restrict`).

**Word expansion** (`kRow_eq_sum_words`): for probability measures `ν, σ`, bounded measurable `φ`
and measurable `J`,

`kRow J ν σ z β a n φ y₀ = ∑_{S ⊆ {0,…,n-1}} (1-z)^{n-|S|} z^{|S|}
  ∫ (∏_{l ≤ n} 1_J(y_l)) φ(y_n) d wordLaw ν σ S`,  `y_l = kWalk y₀ β a g l`.

Proof by induction on `n`, peeling the first step: `kRow (n+1) φ y₀ = kStepZ (kRow n φ) y₀`,
the walk from `y₀` is the walk from `y₀ + β - a g₀` along `g ∘ succ` (`kWalk_succ`), and the
head/tail decomposition turns `∫ dρ(x) ∫ d wordLaw S'` into `∫ d wordLaw S` with `0 ∈ S` iff
`ρ = σ`; the words are regrouped by `range (n+1) = insert 0 (image succ (range n))`.
-/

namespace PGM

noncomputable section

open MeasureTheory ProbabilityTheory Set
open scoped ENNReal

/-! ## Independence of coordinate blocks under product laws -/

/-- The σ-algebra generated by the coordinates in `S`. -/
abbrev kCoordSigma (S : Set ℕ) : MeasurableSpace (ℕ → ℝ) :=
  ⨆ i ∈ S, MeasurableSpace.comap (fun g : ℕ → ℝ => g i) inferInstance

theorem kill_measurable_coord {S : Set ℕ} {i : ℕ} (hi : i ∈ S) :
    Measurable[kCoordSigma S] (fun g : ℕ → ℝ => g i) :=
  Measurable.mono (comap_measurable _)
    (le_iSup₂ (f := fun j (_ : j ∈ S) =>
      MeasurableSpace.comap (fun g : ℕ → ℝ => g j) inferInstance) i hi) le_rfl

theorem kill_measurable_comp {S : Set ℕ} {c : ℕ → ℕ} (hc : ∀ i, c i ∈ S) :
    Measurable[kCoordSigma S] (fun g : ℕ → ℝ => fun i => g (c i)) := by
  let _ : MeasurableSpace (ℕ → ℝ) := kCoordSigma S
  exact measurable_pi_lambda _ fun i => kill_measurable_coord (hc i)

theorem kCoordSigma_le (S : Set ℕ) : kCoordSigma S ≤ MeasurableSpace.pi :=
  iSup₂_le fun i _ => (measurable_pi_apply i).comap_le

variable {Q : ℕ → Measure ℝ} [∀ i, IsProbabilityMeasure (Q i)]

/-- Coordinates in disjoint index sets are independent under a product law. -/
theorem kill_indep_coords {S T : Set ℕ} (hST : Disjoint S T) :
    Indep (kCoordSigma S) (kCoordSigma T) (Measure.infinitePi Q) := by
  have h := iIndepFun_infinitePi (P := Q) (X := fun _ x => x) (fun _ => measurable_id)
  rw [iIndepFun_iff_iIndep] at h
  exact indep_iSup_of_disjoint (fun i => (measurable_pi_apply i).comap_le) h hST

/-- Functions of disjoint coordinate blocks are independent under a product law. -/
theorem kill_indepFun_of_disjoint {β γ : Type*} [MeasurableSpace β] [MeasurableSpace γ]
    {S T : Set ℕ} (hST : Disjoint S T) {F : (ℕ → ℝ) → β} {G : (ℕ → ℝ) → γ}
    (hF : Measurable[kCoordSigma S] F) (hG : Measurable[kCoordSigma T] G) :
    IndepFun F G (Measure.infinitePi Q) := by
  rw [IndepFun_iff_Indep]
  exact indep_of_indep_of_le_right (indep_of_indep_of_le_left (kill_indep_coords hST)
    hF.comap_le) hG.comap_le

/-- Head/tail decomposition of a product law. -/
theorem kill_infinitePi_map_eval_comp (j : ℕ) {c : ℕ → ℕ} (hc : Function.Injective c)
    (hj : ∀ i, c i ≠ j) :
    (Measure.infinitePi Q).map (fun g => (g j, fun i => g (c i))) =
      (Q j).prod (Measure.infinitePi fun i => Q (c i)) := by
  have hdisj : Disjoint ({j} : Set ℕ) (range c) := by
    rw [Set.disjoint_singleton_left]
    rintro ⟨i, hi⟩
    exact hj i hi
  have hind : IndepFun (fun g : ℕ → ℝ => g j) (fun g : ℕ → ℝ => fun i => g (c i))
      (Measure.infinitePi Q) :=
    kill_indepFun_of_disjoint hdisj (kill_measurable_coord rfl)
      (kill_measurable_comp fun i => mem_range_self i)
  rw [hind.map_prod_eq_prod_map_map (measurable_pi_apply j).aemeasurable
    (measurable_pi_lambda _ fun i => measurable_pi_apply (c i)).aemeasurable,
    Measure.infinitePi_map_eval, Measure.map_infinitePi_infinitePi_of_inj hc]

/-- Two disjoint reindexed blocks of a product law are independent product laws. -/
theorem kill_infinitePi_map_blocks {c₁ c₂ : ℕ → ℕ} (h₁ : Function.Injective c₁)
    (h₂ : Function.Injective c₂) (hdisj : ∀ i k, c₁ i ≠ c₂ k) :
    (Measure.infinitePi Q).map (fun g => (fun i => g (c₁ i), fun i => g (c₂ i))) =
      (Measure.infinitePi fun i => Q (c₁ i)).prod (Measure.infinitePi fun i => Q (c₂ i)) := by
  have hd : Disjoint (range c₁) (range c₂) := by
    rw [Set.disjoint_left]
    rintro _ ⟨i, rfl⟩ ⟨k, hk⟩
    exact hdisj i k hk.symm
  have hind : IndepFun (fun g : ℕ → ℝ => fun i => g (c₁ i))
      (fun g : ℕ → ℝ => fun i => g (c₂ i)) (Measure.infinitePi Q) :=
    kill_indepFun_of_disjoint hd (kill_measurable_comp fun i => mem_range_self i)
      (kill_measurable_comp fun i => mem_range_self i)
  rw [hind.map_prod_eq_prod_map_map
    (measurable_pi_lambda _ fun i => measurable_pi_apply (c₁ i)).aemeasurable
    (measurable_pi_lambda _ fun i => measurable_pi_apply (c₂ i)).aemeasurable,
    Measure.map_infinitePi_infinitePi_of_inj h₁, Measure.map_infinitePi_infinitePi_of_inj h₂]

/-! ## Word laws -/

/-- The coordinate law of `wordLaw ν σ S` at coordinate `i`. -/
def wordCoord (ν σ : ProbabilityMeasure ℝ) (S : Finset ℕ) (i : ℕ) : Measure ℝ :=
  ((if i ∈ S then σ else ν : ProbabilityMeasure ℝ) : Measure ℝ)

instance (ν σ : ProbabilityMeasure ℝ) (S : Finset ℕ) (i : ℕ) :
    IsProbabilityMeasure (wordCoord ν σ S i) := by
  unfold wordCoord; infer_instance

theorem wordLaw_eq_infinitePi (ν σ : ProbabilityMeasure ℝ) (S : Finset ℕ) :
    wordLaw ν σ S = Measure.infinitePi (wordCoord ν σ S) := rfl

/-- `wordLaw` depends only on the membership predicate of the word. -/
theorem wordLaw_congr (ν σ : ProbabilityMeasure ℝ) {S₁ S₂ : Finset ℕ}
    (h : ∀ i, i ∈ S₁ ↔ i ∈ S₂) : wordLaw ν σ S₁ = wordLaw ν σ S₂ := by
  have : S₁ = S₂ := Finset.ext h
  rw [this]

/-- **Reindexing.**  For injective `c`, the law of `g ↦ g ∘ c` under `wordLaw ν σ S` is
`wordLaw ν σ (S.preimage c)`. -/
theorem wordLaw_map_comp (ν σ : ProbabilityMeasure ℝ) (S : Finset ℕ) {c : ℕ → ℕ}
    (hc : Function.Injective c) :
    (wordLaw ν σ S).map (fun g i => g (c i)) = wordLaw ν σ (S.preimage c hc.injOn) := by
  rw [wordLaw_eq_infinitePi, Measure.map_infinitePi_infinitePi_of_inj hc,
    wordLaw_eq_infinitePi]
  congr 1
  funext i
  simp only [wordCoord, Finset.mem_preimage]

/-- Reindexed integrals: `∫ F(g ∘ c) d wordLaw S = ∫ F d wordLaw (S.preimage c)`. -/
theorem integral_wordLaw_comp {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (ν σ : ProbabilityMeasure ℝ) (S : Finset ℕ) {c : ℕ → ℕ} (hc : Function.Injective c)
    {F : (ℕ → ℝ) → E} (hF : AEStronglyMeasurable F (wordLaw ν σ (S.preimage c hc.injOn))) :
    ∫ g, F (fun i => g (c i)) ∂(wordLaw ν σ S) = ∫ g, F g ∂(wordLaw ν σ (S.preimage c hc.injOn)) := by
  rw [← wordLaw_map_comp ν σ S hc] at hF ⊢
  rw [integral_map (measurable_pi_lambda _ fun i => measurable_pi_apply (c i)).aemeasurable hF]

/-- **Head/tail decomposition of a word law.**  If `i ∈ S' ↔ i + 1 ∈ S` for all `i`, the law of
`(g 0, g ∘ succ)` under `wordLaw ν σ S` is `wordCoord ν σ S 0 ⊗ wordLaw ν σ S'`. -/
theorem wordLaw_map_head (ν σ : ProbabilityMeasure ℝ) {S S' : Finset ℕ}
    (hS : ∀ i, i ∈ S' ↔ i + 1 ∈ S) :
    (wordLaw ν σ S).map (fun g => (g 0, fun i => g (i + 1))) =
      (wordCoord ν σ S 0).prod (wordLaw ν σ S') := by
  rw [wordLaw_eq_infinitePi, kill_infinitePi_map_eval_comp 0 (c := fun i => i + 1)
    (fun i j h => by simpa using h) (fun i => Nat.succ_ne_zero i), wordLaw_eq_infinitePi]
  congr 2
  funext i
  simp only [wordCoord, hS i]

/-- Head/tail decomposition in integral form, for bounded jointly measurable integrands. -/
theorem integral_wordLaw_head (ν σ : ProbabilityMeasure ℝ) {S S' : Finset ℕ}
    (hS : ∀ i, i ∈ S' ↔ i + 1 ∈ S) {F : ℝ → (ℕ → ℝ) → ℂ}
    (hF : Measurable (Function.uncurry F)) {M : ℝ} (hM : ∀ x g, ‖F x g‖ ≤ M) :
    ∫ g, F (g 0) (fun i => g (i + 1)) ∂(wordLaw ν σ S) =
      ∫ x, ∫ g, F x g ∂(wordLaw ν σ S') ∂(wordCoord ν σ S 0) := by
  have hpair : Measurable (fun g : ℕ → ℝ => (g 0, fun i => g (i + 1))) :=
    (measurable_pi_apply 0).prodMk (measurable_pi_lambda _ fun i => measurable_pi_apply (i + 1))
  have hint : Integrable (Function.uncurry F) ((wordCoord ν σ S 0).prod (wordLaw ν σ S')) :=
    (integrable_const M).mono' hF.aestronglyMeasurable
      (Filter.Eventually.of_forall fun p => hM p.1 p.2)
  have h := integral_map (μ := wordLaw ν σ S) hpair.aemeasurable
    (f := Function.uncurry F) (by rw [wordLaw_map_head ν σ hS]; exact hF.aestronglyMeasurable)
  rw [wordLaw_map_head ν σ hS, integral_prod _ hint] at h
  simp only [Function.uncurry_apply_pair] at h
  exact h.symm

/-- **Disjoint blocks of a word law** are independent: the law of `(g ∘ c₁, g ∘ c₂)` is the
product of the reindexed word laws. -/
theorem wordLaw_map_blocks (ν σ : ProbabilityMeasure ℝ) (S : Finset ℕ) {c₁ c₂ : ℕ → ℕ}
    (h₁ : Function.Injective c₁) (h₂ : Function.Injective c₂) (hdisj : ∀ i k, c₁ i ≠ c₂ k) :
    (wordLaw ν σ S).map (fun g => (fun i => g (c₁ i), fun i => g (c₂ i))) =
      (wordLaw ν σ (S.preimage c₁ h₁.injOn)).prod (wordLaw ν σ (S.preimage c₂ h₂.injOn)) := by
  rw [wordLaw_eq_infinitePi, kill_infinitePi_map_blocks h₁ h₂ hdisj, wordLaw_eq_infinitePi,
    wordLaw_eq_infinitePi]
  congr 2 <;> funext i <;> simp only [wordCoord, Finset.mem_preimage]

/-- **Integrals over disjoint blocks factor**: for measurable `F, G`,
`∫ F(g ∘ c₁) G(g ∘ c₂) d wordLaw S = ∫ F d wordLaw (S.preimage c₁) · ∫ G d wordLaw (S.preimage c₂)`. -/
theorem integral_mul_wordLaw_blocks {𝕜 : Type*} [RCLike 𝕜] (ν σ : ProbabilityMeasure ℝ)
    (S : Finset ℕ) {c₁ c₂ : ℕ → ℕ} (h₁ : Function.Injective c₁) (h₂ : Function.Injective c₂)
    (hdisj : ∀ i k, c₁ i ≠ c₂ k) {F G : (ℕ → ℝ) → 𝕜} (hF : Measurable F) (hG : Measurable G) :
    ∫ g, F (fun i => g (c₁ i)) * G (fun i => g (c₂ i)) ∂(wordLaw ν σ S) =
      (∫ g, F g ∂(wordLaw ν σ (S.preimage c₁ h₁.injOn))) *
        ∫ g, G g ∂(wordLaw ν σ (S.preimage c₂ h₂.injOn)) := by
  have hpair : Measurable (fun g : ℕ → ℝ => (fun i => g (c₁ i), fun i => g (c₂ i))) :=
    (measurable_pi_lambda _ fun i => measurable_pi_apply (c₁ i)).prodMk
      (measurable_pi_lambda _ fun i => measurable_pi_apply (c₂ i))
  have hFG : Measurable (fun p : (ℕ → ℝ) × (ℕ → ℝ) => F p.1 * G p.2) :=
    (hF.comp measurable_fst).mul (hG.comp measurable_snd)
  have h := integral_map (μ := wordLaw ν σ S) hpair.aemeasurable
    (f := fun p : (ℕ → ℝ) × (ℕ → ℝ) => F p.1 * G p.2) hFG.aestronglyMeasurable
  rw [wordLaw_map_blocks ν σ S h₁ h₂ hdisj, integral_prod_mul] at h
  exact h.symm

/-- Restriction to a finite block is measurable for the coordinates of the block. -/
theorem kill_measurable_restrict (s : Finset ℕ) :
    Measurable[kCoordSigma (s : Set ℕ)] (fun g : ℕ → ℝ => s.restrict g) := by
  let _ : MeasurableSpace (ℕ → ℝ) := kCoordSigma (s : Set ℕ)
  exact measurable_pi_lambda _ fun i => kill_measurable_coord (Finset.mem_coe.2 i.2)

/-- **Integrals of functions of disjoint coordinate sets factor** under a word law. -/
theorem integral_mul_wordLaw_of_disjoint {𝕜 : Type*} [RCLike 𝕜] (ν σ : ProbabilityMeasure ℝ)
    (W : Finset ℕ) {S T : Set ℕ} (hST : Disjoint S T) {F G : (ℕ → ℝ) → 𝕜}
    (hF : Measurable[kCoordSigma S] F) (hG : Measurable[kCoordSigma T] G) :
    ∫ g, F g * G g ∂(wordLaw ν σ W) =
      (∫ g, F g ∂(wordLaw ν σ W)) * ∫ g, G g ∂(wordLaw ν σ W) := by
  have hind : IndepFun F G (wordLaw ν σ W) := kill_indepFun_of_disjoint hST hF hG
  exact hind.integral_fun_mul_eq_mul_integral
    (hF.mono (kCoordSigma_le S) le_rfl).aestronglyMeasurable
    (hG.mono (kCoordSigma_le T) le_rfl).aestronglyMeasurable

/-- Functions of two disjoint finite coordinate blocks: the integral of the product factors. -/
theorem integral_mul_wordLaw_finset {𝕜 : Type*} [RCLike 𝕜] (ν σ : ProbabilityMeasure ℝ)
    (W : Finset ℕ) {s t : Finset ℕ} (hst : Disjoint s t) {H₁ : (s → ℝ) → 𝕜} {H₂ : (t → ℝ) → 𝕜}
    (h₁ : Measurable H₁) (h₂ : Measurable H₂) :
    ∫ g, H₁ (s.restrict g) * H₂ (t.restrict g) ∂(wordLaw ν σ W) =
      (∫ g, H₁ (s.restrict g) ∂(wordLaw ν σ W)) * ∫ g, H₂ (t.restrict g) ∂(wordLaw ν σ W) :=
  integral_mul_wordLaw_of_disjoint ν σ W (Finset.disjoint_coe.2 hst)
    (h₁.comp (kill_measurable_restrict s)) (h₂.comp (kill_measurable_restrict t))

/-- The marginal of a word law on a finite block is the finite product of the coordinate laws. -/
theorem integral_wordLaw_restrict {E : Type*} [NormedAddCommGroup E] [NormedSpace ℝ E]
    (ν σ : ProbabilityMeasure ℝ) (W s : Finset ℕ) {H : (s → ℝ) → E}
    (hH : AEStronglyMeasurable H (Measure.pi fun i : s => wordCoord ν σ W i)) :
    ∫ g, H (s.restrict g) ∂(wordLaw ν σ W) =
      ∫ x, H x ∂(Measure.pi fun i : s => wordCoord ν σ W i) :=
  integral_restrict_infinitePi (wordCoord ν σ W) hH

/-! ## The walk -/

theorem kWalk_zero (y₀ β a : ℝ) (g : ℕ → ℝ) : kWalk y₀ β a g 0 = y₀ := by
  simp [kWalk, gapKeys]

/-- The walk after the first step: `y_{l+1}(y₀, g) = y_l(y₀ + β - a g₀, g ∘ succ)`. -/
theorem kWalk_succ (y₀ β a : ℝ) (g : ℕ → ℝ) (l : ℕ) :
    kWalk y₀ β a g (l + 1) = kWalk (y₀ + β - a * g 0) β a (fun i => g (i + 1)) l := by
  simp only [kWalk, gapKeys, Finset.sum_range_succ']
  push_cast
  ring

theorem measurable_kWalk_prod (β a : ℝ) (l : ℕ) :
    Measurable (fun p : ℝ × (ℕ → ℝ) => kWalk p.1 β a p.2 l) := by
  unfold kWalk
  have hk : Measurable (fun p : ℝ × (ℕ → ℝ) => gapKeys p.2 l) :=
    (measurable_pi_apply l).comp (measurable_gapKeys.comp measurable_snd)
  exact (measurable_fst.add_const _).sub (hk.const_mul a)

/-- The integrand of the word expansion: `(∏_{l ≤ n} 1_J(y_l)) φ(y_n)`. -/
def kWordInt (J : Set ℝ) (β a : ℝ) (n : ℕ) (φ : ℝ → ℂ) (y₀ : ℝ) (g : ℕ → ℝ) : ℂ :=
  (∏ l ∈ Finset.range (n + 1), J.indicator (fun _ => (1 : ℂ)) (kWalk y₀ β a g l)) *
    φ (kWalk y₀ β a g n)

theorem measurable_kWordInt_prod {J : Set ℝ} (hJ : MeasurableSet J) (β a : ℝ) (n : ℕ)
    {φ : ℝ → ℂ} (hφ : Measurable φ) :
    Measurable (fun p : ℝ × (ℕ → ℝ) => kWordInt J β a n φ p.1 p.2) := by
  unfold kWordInt
  refine Measurable.mul ?_ (hφ.comp (measurable_kWalk_prod β a n))
  refine Finset.measurable_prod _ fun l _ => ?_
  exact (measurable_const.indicator hJ).comp (measurable_kWalk_prod β a l)

theorem measurable_kWordInt_shift {J : Set ℝ} (hJ : MeasurableSet J) (β a : ℝ) (n : ℕ)
    {φ : ℝ → ℂ} (hφ : Measurable φ) (y₀ : ℝ) :
    Measurable (Function.uncurry fun (x : ℝ) (g : ℕ → ℝ) =>
      kWordInt J β a n φ (y₀ + β - a * x) g) := by
  have h1 : Measurable (fun p : ℝ × (ℕ → ℝ) => ((y₀ + β - a * p.1, p.2) : ℝ × (ℕ → ℝ))) := by
    fun_prop
  have h2 := (measurable_kWordInt_prod hJ β a n hφ).comp h1
  have e : (Function.uncurry fun (x : ℝ) (g : ℕ → ℝ) => kWordInt J β a n φ (y₀ + β - a * x) g) =
      (fun p : ℝ × (ℕ → ℝ) => kWordInt J β a n φ p.1 p.2) ∘
        (fun p : ℝ × (ℕ → ℝ) => ((y₀ + β - a * p.1, p.2) : ℝ × (ℕ → ℝ))) := by
    funext p; rfl
  rw [e]
  exact h2

theorem norm_kWordInt_le {J : Set ℝ} (β a : ℝ) (n : ℕ) {φ : ℝ → ℂ} {M : ℝ}
    (hM : ∀ y, ‖φ y‖ ≤ M) (y₀ : ℝ) (g : ℕ → ℝ) : ‖kWordInt J β a n φ y₀ g‖ ≤ M := by
  unfold kWordInt
  rw [norm_mul]
  have hp : ‖∏ l ∈ Finset.range (n + 1), J.indicator (fun _ => (1 : ℂ)) (kWalk y₀ β a g l)‖ ≤ 1 := by
    rw [norm_prod]
    refine Finset.prod_le_one (fun l _ => norm_nonneg _) fun l _ => ?_
    by_cases h : kWalk y₀ β a g l ∈ J
    · simp [indicator_of_mem h]
    · simp [indicator_of_notMem h]
  have hM0 : 0 ≤ M := (norm_nonneg _).trans (hM 0)
  calc _ ≤ 1 * M := mul_le_mul hp (hM _) (norm_nonneg _) zero_le_one
    _ = M := one_mul M

/-- The word integrand after the first step. -/
theorem kWordInt_succ (J : Set ℝ) (β a : ℝ) (n : ℕ) (φ : ℝ → ℂ) (y₀ : ℝ) (g : ℕ → ℝ) :
    kWordInt J β a (n + 1) φ y₀ g = J.indicator (fun _ => (1 : ℂ)) y₀ *
      kWordInt J β a n φ (y₀ + β - a * g 0) (fun i => g (i + 1)) := by
  unfold kWordInt
  rw [Finset.prod_range_succ' _ (n + 1), kWalk_zero]
  simp only [kWalk_succ]
  ring

/-! ## The word expansion -/

/-- Regrouping the words of length `n + 1` by their first letter. -/
theorem kill_sum_powerset_range_succ {M : Type*} [AddCommMonoid M] (n : ℕ)
    (f : Finset ℕ → M) :
    ∑ S ∈ (Finset.range (n + 1)).powerset, f S =
      ∑ S ∈ (Finset.range n).powerset, (f (S.image (· + 1)) + f (insert 0 (S.image (· + 1)))) := by
  have hr : Finset.range (n + 1) = insert 0 ((Finset.range n).image (· + 1)) := by
    rw [Finset.range_add_one', Finset.map_eq_image]
    rfl
  have h0 : (0 : ℕ) ∉ (Finset.range n).image (· + 1) := by simp
  have hinj : Set.InjOn (fun S : Finset ℕ => S.image (· + 1)) ((Finset.range n).powerset : Set _) :=
    fun S _ T _ h => Finset.image_injective (fun i j hij => by simpa using hij) h
  rw [hr, Finset.sum_powerset_insert h0, Finset.powerset_image, Finset.sum_image hinj,
    Finset.sum_image hinj, ← Finset.sum_add_distrib]

theorem kill_mem_image_succ_iff (S : Finset ℕ) (i : ℕ) :
    i ∈ S ↔ i + 1 ∈ S.image (· + 1) := by
  simp

theorem kill_mem_insert_image_succ_iff (S : Finset ℕ) (i : ℕ) :
    i ∈ S ↔ i + 1 ∈ insert 0 (S.image (· + 1)) := by
  simp

theorem kill_card_image_succ (S : Finset ℕ) : (S.image (· + 1)).card = S.card :=
  Finset.card_image_of_injective _ (fun i j h => by simpa using h)

theorem kill_card_insert_image_succ (S : Finset ℕ) :
    (insert 0 (S.image (· + 1))).card = S.card + 1 := by
  rw [Finset.card_insert_of_notMem (by simp), kill_card_image_succ]

/-- The first killed step against a row given by a word sum. -/
theorem kill_integral_first_step {J : Set ℝ} (hJ : MeasurableSet J) (ν σ : ProbabilityMeasure ℝ)
    (β a : ℝ) (n : ℕ) {φ : ℝ → ℂ} (hφ : Measurable φ) {M : ℝ} (hM : ∀ y, ‖φ y‖ ≤ M)
    (y₀ : ℝ) {S S' : Finset ℕ} (hS : ∀ i, i ∈ S' ↔ i + 1 ∈ S) :
    ∫ x, (∫ g, kWordInt J β a n φ (y₀ + β - a * x) g ∂(wordLaw ν σ S')) ∂(wordCoord ν σ S 0) =
      ∫ g, kWordInt J β a n φ (y₀ + β - a * g 0) (fun i => g (i + 1)) ∂(wordLaw ν σ S) := by
  have hF := measurable_kWordInt_shift hJ β a n hφ y₀
  exact (integral_wordLaw_head ν σ hS hF (fun x g => norm_kWordInt_le β a n hM _ g)).symm

/-- **Word expansion of the complex killed row.**  For probability measures `ν, σ`, measurable
`J` and bounded measurable `φ`,
`kRow J ν σ z β a n φ y₀ = ∑_{S ⊆ range n} (1-z)^{n-|S|} z^{|S|}
  ∫ (∏_{l ≤ n} 1_J(kWalk y₀ β a g l)) φ(kWalk y₀ β a g n) d wordLaw ν σ S`. -/
theorem kRow_eq_sum_words {J : Set ℝ} (hJ : MeasurableSet J) (ν σ : ProbabilityMeasure ℝ)
    (z : ℂ) (β a : ℝ) {φ : ℝ → ℂ} (hφ : Measurable φ) {M : ℝ} (hM : ∀ y, ‖φ y‖ ≤ M)
    (n : ℕ) (y₀ : ℝ) :
    kRow J ν σ z β a n φ y₀ =
      ∑ S ∈ (Finset.range n).powerset, (1 - z) ^ (n - S.card) * z ^ S.card *
        ∫ g, (∏ l ∈ Finset.range (n + 1), J.indicator (fun _ => (1 : ℂ)) (kWalk y₀ β a g l)) *
          φ (kWalk y₀ β a g n) ∂(wordLaw ν σ S) := by
  change kRow J ν σ z β a n φ y₀ = ∑ S ∈ (Finset.range n).powerset,
    (1 - z) ^ (n - S.card) * z ^ S.card * ∫ g, kWordInt J β a n φ y₀ g ∂(wordLaw ν σ S)
  induction n generalizing y₀ with
  | zero =>
    simp only [Finset.range_zero, Finset.powerset_empty, Finset.sum_singleton,
      Finset.card_empty, pow_zero, kWordInt, zero_add, Finset.prod_range_one,
      kWalk_zero, integral_const, probReal_univ, one_smul]
    simp only [kRow, Function.iterate_zero, id_eq]
    by_cases hy : y₀ ∈ J
    · simp [indicator_of_mem hy]
    · simp [indicator_of_notMem hy]
  | succ n ih =>
    -- the coefficients
    set c : Finset ℕ → ℂ := fun S => (1 - z) ^ (n - S.card) * z ^ S.card with hc
    set I : Finset ℕ → ℂ := fun S => ∫ g, kWordInt J β a (n + 1) φ y₀ g ∂(wordLaw ν σ S) with hI
    have hrow : kRow J ν σ z β a (n + 1) φ y₀ =
        kStepZ J ν σ z β a (kRow J ν σ z β a n φ) y₀ := by
      simp only [kRow, Function.iterate_succ_apply']
    rw [hrow]
    by_cases hy : y₀ ∉ J
    · -- both sides vanish
      have h0 : ∀ S, I S = 0 := by
        intro S
        simp only [hI, kWordInt_succ, indicator_of_notMem hy, zero_mul, integral_zero]
      unfold kStepZ kStep
      simp only [indicator_of_notMem hy, mul_zero, add_zero]
      symm
      refine Finset.sum_eq_zero fun S _ => ?_
      have := h0 S
      simp only [hI] at this
      rw [this, mul_zero]
    push Not at hy
    -- the first step against each word of length `n`
    have hmeas : ∀ S' : Finset ℕ, Measurable (fun x : ℝ =>
        ∫ g, kWordInt J β a n φ (y₀ + β - a * x) g ∂(wordLaw ν σ S')) := by
      intro S'
      exact (measurable_kWordInt_shift hJ β a n hφ y₀).stronglyMeasurable.integral_prod_right.measurable
    have hbd : ∀ (S' : Finset ℕ) (x : ℝ),
        ‖∫ g, kWordInt J β a n φ (y₀ + β - a * x) g ∂(wordLaw ν σ S')‖ ≤ M := by
      intro S' x
      have h := norm_integral_le_of_norm_le_const (μ := wordLaw ν σ S')
        (Filter.Eventually.of_forall fun g => norm_kWordInt_le (J := J) β a n hM
          (y₀ + β - a * x) g)
      rwa [probReal_univ, mul_one] at h
    have hstep : ∀ (ρ : Measure ℝ) [IsProbabilityMeasure ρ],
        ∫ x, kRow J ν σ z β a n φ (y₀ + β - a * x) ∂ρ =
          ∑ S' ∈ (Finset.range n).powerset,
            c S' * ∫ x, ∫ g, kWordInt J β a n φ (y₀ + β - a * x) g ∂(wordLaw ν σ S') ∂ρ := by
      intro ρ _
      simp only [ih]
      rw [integral_finsetSum]
      · refine Finset.sum_congr rfl fun S' _ => ?_
        rw [integral_const_mul]
      · intro S' _
        refine Integrable.const_mul ?_ _
        exact (integrable_const M).mono' (hmeas S').aestronglyMeasurable
          (Filter.Eventually.of_forall fun x => hbd S' x)
    have hν : ∀ S' : Finset ℕ,
        ∫ x, ∫ g, kWordInt J β a n φ (y₀ + β - a * x) g ∂(wordLaw ν σ S') ∂(ν : Measure ℝ) =
          I (S'.image (· + 1)) := by
      intro S'
      have hw : wordCoord ν σ (S'.image (· + 1)) 0 = (ν : Measure ℝ) := by
        simp [wordCoord]
      rw [← hw, kill_integral_first_step hJ ν σ β a n hφ hM y₀
        (kill_mem_image_succ_iff S'), hI]
      simp only [kWordInt_succ, indicator_of_mem hy, one_mul]
    have hσ : ∀ S' : Finset ℕ,
        ∫ x, ∫ g, kWordInt J β a n φ (y₀ + β - a * x) g ∂(wordLaw ν σ S') ∂(σ : Measure ℝ) =
          I (insert 0 (S'.image (· + 1))) := by
      intro S'
      have hw : wordCoord ν σ (insert 0 (S'.image (· + 1))) 0 = (σ : Measure ℝ) := by
        simp [wordCoord]
      rw [← hw, kill_integral_first_step hJ ν σ β a n hφ hM y₀
        (kill_mem_insert_image_succ_iff S'), hI]
      simp only [kWordInt_succ, indicator_of_mem hy, one_mul]
    unfold kStepZ kStep
    simp only [indicator_of_mem hy]
    rw [hstep (ν : Measure ℝ), hstep (σ : Measure ℝ)]
    simp only [hν, hσ]
    rw [kill_sum_powerset_range_succ, Finset.mul_sum, Finset.mul_sum, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun S' hS' => ?_
    have hcard : S'.card ≤ n := by
      simpa using Finset.card_le_card (Finset.mem_powerset.1 hS')
    rw [kill_card_image_succ, kill_card_insert_image_succ, hc]
    simp only
    have e1 : n + 1 - S'.card = (n - S'.card) + 1 := by omega
    have e2 : n + 1 - (S'.card + 1) = n - S'.card := by omega
    rw [e1, e2, pow_succ, pow_succ]
    ring

end

end PGM
