import PLAStochastic.Index.GEP.StrongApprox.Tree.LeafPrefix
import PLAStochastic.Index.GEP.StrongApprox.Coupling.BadEvents

/-! # Leaf-prefix probability bounds for the actual common-uniform tree -/

namespace PGM

noncomputable section

open MeasureTheory Measure ProbabilityTheory Set Function Finset

/-- The pair of leaf vectors generated by one common seed. -/
def saTreeLeafPair {p q : ℕ → ℝ → ℝ}
    (hp : ∀ j, SADensity (p j)) (hq : ∀ j, SADensity (q j)) (J : ℕ)
    (z : ℝ × SATreeNoise J) : (Fin (2 ^ J) → ℝ) × (Fin (2 ^ J) → ℝ) :=
  (saTreeFlattenFin J (saTreeFromUniform hp J z),
    saTreeFlattenFin J (saTreeFromUniform hq J z))

theorem measurable_saTreeLeafPair {p q : ℕ → ℝ → ℝ}
    (hp : ∀ j, SADensity (p j)) (hq : ∀ j, SADensity (q j)) (J : ℕ) :
    Measurable (saTreeLeafPair hp hq J) :=
  ((measurable_saTreeFlattenFin J).comp (measurable_saTreeFromUniform hp J)).prodMk
    ((measurable_saTreeFlattenFin J).comp (measurable_saTreeFromUniform hq J))

/-- The actual root quantile discrepancy. -/
def saTreeRootError {p q : ℕ → ℝ → ℝ}
    (hp : ∀ j, SADensity (p j)) (hq : ∀ j, SADensity (q j)) (J : ℕ)
    (z : ℝ × SATreeNoise J) : ℝ :=
  saQuantile (cdf ((hp J).law : Measure ℝ)) z.1 -
    saQuantile (cdf ((hq J).law : Measure ℝ)) z.1

theorem measurable_saTreeRootError {p q : ℕ → ℝ → ℝ}
    (hp : ∀ j, SADensity (p j)) (hq : ∀ j, SADensity (q j)) (J : ℕ) :
    Measurable (saTreeRootError hp hq J) :=
  ((hp J).regularCDF.measurable_quantile.comp measurable_fst).sub
    ((hq J).regularCDF.measurable_quantile.comp measurable_fst)

/-- The centered left-child discrepancy at an internal node. -/
def saTreeSplitDefect {p q : ℕ → ℝ → ℝ}
    (hp : ∀ j, SADensity (p j)) (hq : ∀ j, SADensity (q j)) (J d : ℕ)
    (z : ℝ × SATreeNoise J) (i : SATreeIndex d) : ℝ :=
  saSplitQuantile (hp (J - d - 1)) (saTreeUniformNode hp J d z i).1
      (saTreeUniformNode hp J d z i).2 -
    saSplitQuantile (hq (J - d - 1)) (saTreeUniformNode hq J d z i).1
      (saTreeUniformNode hq J d z i).2 -
    ((saTreeUniformNode hp J d z i).1 - (saTreeUniformNode hq J d z i).1) / 2

theorem measurable_saTreeSplitDefect {p q : ℕ → ℝ → ℝ}
    (hp : ∀ j, SADensity (p j)) (hq : ∀ j, SADensity (q j)) (J d : ℕ)
    (i : SATreeIndex d) : Measurable (fun z => saTreeSplitDefect hp hq J d z i) := by
  have hpnode := measurable_saTreeUniformNode hp J d i
  have hqnode := measurable_saTreeUniformNode hq J d i
  exact (((hp (J - d - 1)).measurable_splitQuantile.comp hpnode).sub
    ((hq (J - d - 1)).measurable_splitQuantile.comp hqnode)).sub
    ((hpnode.fst.sub hqnode.fst).div_const 2)

/-- All leaf prefixes are controlled by the root and the internal conditional-quantile defects. -/
theorem saTreeLeafPair_prefix_bound {p q : ℕ → ℝ → ℝ}
    (hp : ∀ j, SADensity (p j)) (hq : ∀ j, SADensity (q j)) (J : ℕ)
    (z : ℝ × SATreeNoise J) {R D : ℝ} (hR : 0 ≤ R) (hD : 0 ≤ D)
    (hroot : |saTreeRootError hp hq J z| ≤ R)
    (hnode : ∀ d < J, ∀ i : SATreeIndex d, |saTreeSplitDefect hp hq J d z i| ≤ D) :
    ∀ k ≤ 2 ^ J, |vkeys (saTreeLeafPair hp hq J z).1 k -
      vkeys (saTreeLeafPair hp hq J z).2 k| ≤ ((J : ℝ) + 1) * (R + 2 * D) := by
  apply saTree_prefix_error hp hq J _ _ z.2 hR hD hroot
  intro d hd i
  rw [saTreeNode_left hp J d hd, saTreeNode_left hq J d hd]
  exact hnode d hd i

/-- A finite union bound on the constructed coupling; no independence of bad events is needed. -/
theorem saTreeLeafPair_bad_bound {p q : ℕ → ℝ → ℝ}
    (hp : ∀ j, SADensity (p j)) (hq : ∀ j, SADensity (q j)) (J : ℕ)
    {R D r : ℝ} {b : ℕ → ℝ} (hR : 0 ≤ R) (hD : 0 ≤ D)
    (hroot : (saTreeSharedLaw J).real {z | R < |saTreeRootError hp hq J z|} ≤ r)
    (hnode : ∀ d < J, ∀ i : SATreeIndex d,
      (saTreeSharedLaw J).real {z | D < |saTreeSplitDefect hp hq J d z i|} ≤ b d) :
    ((saTreeSharedLaw J).map (saTreeLeafPair hp hq J)).real
      (saLeafBad (2 ^ J) (((J : ℝ) + 1) * (R + 2 * D))) ≤
        r + ∑ d ∈ range J, (2 ^ d : ℕ) * b d := by
  classical
  rw [map_measureReal_apply (measurable_saTreeLeafPair hp hq J) (measurableSet_saLeafBad _ _)]
  let rootBad := {z | R < |saTreeRootError hp hq J z|}
  let nodeBad := fun d (i : SATreeIndex d) => {z | D < |saTreeSplitDefect hp hq J d z i|}
  have hsub : saTreeLeafPair hp hq J ⁻¹' saLeafBad (2 ^ J) (((J : ℝ) + 1) * (R + 2 * D)) ⊆
      rootBad ∪ ⋃ d ∈ range J, ⋃ i, nodeBad d i := by
    intro z hz
    by_contra hn
    have hr : |saTreeRootError hp hq J z| ≤ R := by
      by_contra hr
      exact hn (Or.inl (lt_of_not_ge hr))
    have hl : ∀ d < J, ∀ i : SATreeIndex d, |saTreeSplitDefect hp hq J d z i| ≤ D := by
      intro d hd i
      by_contra hi
      apply hn
      right
      exact mem_iUnion.2 ⟨d, mem_iUnion.2 ⟨mem_range.2 hd, mem_iUnion.2 ⟨i, lt_of_not_ge hi⟩⟩⟩
    obtain ⟨k, hk, he⟩ := hz
    exact (not_lt_of_ge (saTreeLeafPair_prefix_bound hp hq J z hR hD hr hl k hk)) he
  refine (measureReal_mono hsub).trans ((measureReal_union_le _ _).trans ?_)
  apply add_le_add hroot
  refine (measureReal_biUnion_finset_le (range J) _).trans ?_
  apply sum_le_sum
  intro d hd
  refine (measureReal_iUnion_fintype_le (nodeBad d)).trans ?_
  calc
    _ ≤ ∑ _ : SATreeIndex d, b d := sum_le_sum fun i _ => hnode d (mem_range.1 hd) i
    _ = _ := by simp [card_saTreeIndex]

end

end PGM
