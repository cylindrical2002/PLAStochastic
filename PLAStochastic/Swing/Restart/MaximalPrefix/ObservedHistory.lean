import PLAStochastic.Swing.Restart.MaximalPrefix.UniformMean
import PLAStochastic.Swing.Restart.MaximalPrefix.HistoryIndependence

/-! # The three-point lemma with its actual observation history -/
noncomputable section
open MeasureTheory ProbabilityTheory BrownianAffine Filter Set
open scoped NNReal ENNReal Topology
namespace SwingRepair
set_option backward.isDefEq.respectTransparency false

/-- D_1=x and D_i=x+W_{i-1}; the unused index-zero sample is set to zero. -/
def nativeCarriedSamples {Ω : Type*} (X : ℕ → Ω → ℝ) (x : Ω → ℝ) (n : ℕ) (ω : Ω) : ℝ :=
  if n = 0 then 0 else x ω + cumulativeSamples X (n - 1) ω

@[simp] theorem nativeCarriedSamples_zero {Ω : Type*} (X : ℕ → Ω → ℝ) (x : Ω → ℝ) (ω : Ω) :
    nativeCarriedSamples X x 0 ω = 0 := by simp [nativeCarriedSamples]

@[simp] theorem nativeCarriedSamples_succ {Ω : Type*} (X : ℕ → Ω → ℝ) (x : Ω → ℝ) (n : ℕ) (ω : Ω) :
    nativeCarriedSamples X x (n + 1) ω = x ω + cumulativeSamples X n ω := by
  simp [nativeCarriedSamples]

theorem cumulativeSamples_add_shift {Ω : Type*} (X : ℕ → Ω → ℝ) (n k : ℕ) (ω : Ω) :
    cumulativeSamples X (n + k) ω = cumulativeSamples X n ω +
      cumulativeSamples (fun j => X (n + j)) k ω := by
  induction k with
  | zero => simp
  | succ k ih =>
    rw [show n + (k + 1) = (n + k) + 1 by omega, cumulativeSamples_succ, cumulativeSamples_succ, ih]
    ring

theorem nativeCarriedSamples_shift {Ω : Type*} (X : ℕ → Ω → ℝ) (x : Ω → ℝ)
    {n : ℕ} (hn : 1 ≤ n) (ω : Ω) (k : ℕ) :
    nativeCarriedSamples X x (n + k) ω = nativeCarriedSamples X x n ω +
      cumulativeSamples (fun j => X (n - 1 + j)) k ω := by
  obtain ⟨l, rfl⟩ := Nat.exists_eq_succ_of_ne_zero (by omega : n ≠ 0)
  simp only [Nat.succ_eq_add_one]
  rw [show l + 1 + k = (l + k) + 1 by omega]
  simp only [nativeCarriedSamples_succ, Nat.add_sub_cancel_right, cumulativeSamples_add_shift]
  ring

variable {Ω : Type*} [mΩ : MeasurableSpace Ω] {μ : Measure Ω} {X : ℕ → Ω → ℝ}

theorem nativeCarriedSamples_measurable (hX : ∀ k, Measurable (X k)) {x : Ω → ℝ}
    (hx : Measurable x) (n : ℕ) : Measurable (nativeCarriedSamples X x n) := by
  cases n with
  | zero => simpa only [nativeCarriedSamples_zero] using! (measurable_const (a := (0 : ℝ)))
  | succ n =>
    have hc : Measurable (cumulativeSamples X n) := Finset.measurable_sum _ (fun k _ => hX k)
    simpa only [nativeCarriedSamples_succ] using! hx.add hc

omit mΩ in
/-- At observation n, exactly the first n-1 fresh increments have been revealed. -/
theorem nativeCarriedSamples_measurable_history
    {m : MeasurableSpace Ω} {x : Ω → ℝ} (hx : Measurable[m] x) {j n : ℕ} (hj : j ≤ n) :
    Measurable[m ⊔ incrementIndexSpace X (Set.Iio (n - 1))] (nativeCarriedSamples X x j) := by
  let : MeasurableSpace Ω := m ⊔ incrementIndexSpace X (Set.Iio (n - 1))
  cases j with
  | zero => simpa only [nativeCarriedSamples_zero] using! (measurable_const (a := (0 : ℝ)))
  | succ j =>
    have hx' : Measurable x := hx.mono le_sup_left le_rfl
    have hc : Measurable (cumulativeSamples X j) := by
      apply Finset.measurable_sum
      intro k hk
      have hk' : k ∈ Set.Iio (n - 1) := by have := Finset.mem_range.mp hk; change k < n - 1; omega
      exact (incrementIndexSpace_eval hk').mono le_sup_right le_rfl
    simpa only [nativeCarriedSamples_succ] using! hx'.add hc

/-- The sigma-algebra generated by the input history and actual D_1,...,D_n observations. -/
abbrev nativeCarriedHistory (X : ℕ → Ω → ℝ) (x : Ω → ℝ) (m : MeasurableSpace Ω) (n : ℕ) :
    MeasurableSpace Ω := m ⊔ incrementIndexSpace (nativeCarriedSamples X x) (Set.Icc 1 n)

omit mΩ in
theorem nativeCarriedHistory_eq
    {m : MeasurableSpace Ω} {x : Ω → ℝ} (hx : Measurable[m] x) (n : ℕ) :
    nativeCarriedHistory X x m n = m ⊔ incrementIndexSpace X (Set.Iio (n - 1)) := by
  apply le_antisymm
  · apply sup_le le_sup_left
    apply iSup_le
    intro j
    apply iSup_le
    intro hj
    exact (nativeCarriedSamples_measurable_history hx hj.2).comap_le
  · apply sup_le le_sup_left
    apply iSup_le
    intro k
    apply iSup_le
    intro hk
    have hk' : k < n - 1 := hk
    have hm₁ : Measurable[nativeCarriedHistory X x m n] (nativeCarriedSamples X x (k + 1)) :=
      (incrementIndexSpace_eval (X := nativeCarriedSamples X x)
        (show k + 1 ∈ Set.Icc 1 n from ⟨by omega, by omega⟩)).mono le_sup_right le_rfl
    have hm₂ : Measurable[nativeCarriedHistory X x m n] (nativeCarriedSamples X x (k + 2)) :=
      (incrementIndexSpace_eval (X := nativeCarriedSamples X x)
        (show k + 2 ∈ Set.Icc 1 n from ⟨by omega, by omega⟩)).mono le_sup_right le_rfl
    have heq : X k = fun ω => nativeCarriedSamples X x (k + 2) ω - nativeCarriedSamples X x (k + 1) ω := by
      funext ω
      rw [show k + 2 = (k + 1) + 1 by omega, nativeCarriedSamples_succ, nativeCarriedSamples_succ,
        cumulativeSamples_succ]
      ring
    rw [heq]
    exact (hm₂.sub hm₁).comap_le

/-- Lemma C.1 conditional inequality for the exact sigma-algebra generated by
initial history and D_1,...,D_n. Freshness at time n is a conclusion of the proof. -/
theorem nativeCarriedPrefix_conditional_bound
    (hX : ∀ k, Measurable (X k)) (hi : iIndepFun X μ)
    (hG : ∀ k, μ.map (X k) = gaussianReal 0 1)
    {m : MeasurableSpace Ω} (hm : m ≤ mΩ)
    (hinit : Indep (incrementIndexSpace X Set.univ) m μ)
    {x Q : Ω → ℝ} (hx : Measurable[m] x) (hQ : Measurable[m] Q)
    {n : ℕ} (hn : 1 ≤ n) {E : ℝ} (hE : 0 < E) (b : ℕ) :
    μ[({ω | ((n + 2 * ⌈8 * E ^ 2⌉₊ * b : ℕ) : WithTop ℕ) ≤
        nativePrefixLength (nativeCarriedSamples X x) Q E ω}).indicator (fun _ => (1 : ℝ)) |
        nativeCarriedHistory X x m n] ≤ᵐ[μ]
      ({ω | (n : WithTop ℕ) ≤ nativePrefixLength (nativeCarriedSamples X x) Q E ω}).indicator
        (fun _ => gaussianBlockPass.toReal ^ b) := by
  let : MeasurableSpace Ω := mΩ
  rw [nativeCarriedHistory_eq hx]
  have hY : iIndepFun (fun k => X (n - 1 + k)) μ :=
    hi.precomp (g := fun k => n - 1 + k) (by intro a b hab; dsimp at hab; omega)
  exact nativePrefixLength_conditional_three_point_bound
    (fun k => hX (n - 1 + k)) hY (fun k => hG (n - 1 + k))
    (sup_le hm (incrementIndexSpace_le hX _))
    (shiftedIncrements_indep_history hX hi hm hinit (n - 1))
    (nativeCarriedSamples X x) Q (nativeCarriedSamples_measurable hX (hx.mono hm le_rfl))
    (hQ.mono le_sup_left le_rfl) hn (fun k hk => nativeCarriedSamples_measurable_history hx hk)
    (nativeCarriedSamples_shift X x hn) hE _ b (Nat.le_ceil _)

/-- Lemma C.1 unconditional tail, uniform over all carried values and anchors. -/
theorem nativeCarriedPrefix_tail
    (hX : ∀ k, Measurable (X k)) (hi : iIndepFun X μ)
    (hG : ∀ k, μ.map (X k) = gaussianReal 0 1)
    (x Q : Ω → ℝ) {E : ℝ} (hE : 0 < E) (b : ℕ) :
    μ {ω | ((1 + 2 * ⌈8 * E ^ 2⌉₊ * b : ℕ) : WithTop ℕ) ≤
      nativePrefixLength (nativeCarriedSamples X x) Q E ω} ≤ gaussianBlockPass ^ b := by
  apply nativePrefixLength_three_point_tail hX hi hG _ Q _ hE _ b (Nat.le_ceil _)
  intro ω k
  simpa only [Nat.sub_self, Nat.zero_add] using
    nativeCarriedSamples_shift X x (n := 1) (by decide) ω k

/-- Lemma C.1 mean bound with the actual carried path and the paper's ceiling convention. -/
theorem nativeCarriedPrefix_mean_le
    (hX : ∀ k, Measurable (X k)) (hi : iIndepFun X μ)
    (hG : ∀ k, μ.map (X k) = gaussianReal 0 1)
    {x Q : Ω → ℝ} (hx : Measurable x) (hQ : Measurable Q) {E : ℝ} (hE : 0 < E) :
    (∫ ω, (nativePrefixLengthNat (nativeCarriedSamples X x) Q E ω : ℝ) ∂μ) ≤
      2 * (⌈8 * E ^ 2⌉₊ : ℝ) / (1 - gaussianBlockPass.toReal) := by
  apply nativePrefixLengthNat_mean_le_ceil hX hi hG _ Q
    (nativeCarriedSamples_measurable hX hx) hQ _ hE
  intro ω k
  simpa only [Nat.sub_self, Nat.zero_add] using
    nativeCarriedSamples_shift X x (n := 1) (by decide) ω k

/-- The actual maximal carried prefix is finite almost surely, so the real-valued
mean above is the expectation of N itself rather than a truncated substitute. -/
theorem nativeCarriedPrefix_ae_finite
    (hX : ∀ k, Measurable (X k)) (hi : iIndepFun X μ)
    (hG : ∀ k, μ.map (X k) = gaussianReal 0 1)
    (x Q : Ω → ℝ) {E : ℝ} (hE : 0 < E) :
    ∀ᵐ ω ∂μ, nativePrefixLength (nativeCarriedSamples X x) Q E ω ≠ ⊤ := by
  apply nativePrefixLength_ae_finite hX hi hG _ Q _ hE ⌈8 * E ^ 2⌉₊ (Nat.le_ceil _)
  intro ω k
  simpa only [Nat.sub_self, Nat.zero_add] using
    nativeCarriedSamples_shift X x (n := 1) (by decide) ω k

end SwingRepair
